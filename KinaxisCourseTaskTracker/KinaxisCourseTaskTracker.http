@Host = http://localhost:5089
@AdminToken = 
@MentorToken = 
@LearnerToken = 

### ============================================
### 1. LOGIN REQUESTS (All Roles)
### ============================================

### 1a. Login as System Admin
POST {{Host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@supplychainz.in",
  "password": "AdminPass123!"
}

### 1b. Login as Training Mentor
POST {{Host}}/api/auth/login
Content-Type: application/json

{
  "email": "mentor@supplychainz.in",
  "password": "MentorPass123!"
}

### 1c. Login as Learner (John)
POST {{Host}}/api/auth/login
Content-Type: application/json

{
  "email": "john.learner@supplychainz.in",
  "password": "LearnerPass123!"
}

### 1d. Login as Learner (Jane)
POST {{Host}}/api/auth/login
Content-Type: application/json

{
  "email": "jane.learner@supplychainz.in",
  "password": "LearnerPass123!"
}


### ============================================
### 2. AUTHENTICATED ENDPOINTS
### ============================================

### 2a. Get Profile (Requires Bearer Token)
GET {{Host}}/api/users/profile
Authorization: Bearer {{AdminToken}}

### 2b. Get Available Courses
GET {{Host}}/api/courses
Authorization: Bearer {{LearnerToken}}

### 2c. Get Mentor Dashboard (Requires Mentor Role)
GET {{Host}}/api/mentor/learners
Authorization: Bearer {{MentorToken}}
